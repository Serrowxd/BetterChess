# Lichess API token (https://lichess.org/api-clients)
LICHESS_API_TOKEN=your_token

# Evaluation via Chess API (https://chess-api.com)
# CHESS_API_DEPTH=12

# Gemini API (https://aistudio.google.com/app/apikey)
# The default model is gemini-3.0-flash
GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-3.0-flash
